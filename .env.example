VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Browser-visible by design. Restrict by HTTP referrers and Maps JavaScript API.
VITE_GOOGLE_MAPS_BROWSER_KEY=
VITE_PRIVACY_URL=/privacy.html
VITE_TERMS_URL=/terms.html
# Server-only: configure through Supabase secrets, never VITE_ variables.
# GOOGLE_MAPS_SERVER_KEY=
# AI_API_KEY=
# AI_MODEL=gpt-4.1-mini
# EXCHANGE_RATE_URL=https://your-provider.example/latest
# EXCHANGE_RATE_KEY=
# ALLOWED_ORIGIN=https://your-site.example
# Before enabling Google services, host privacy.html and terms.html at public URLs
# (the private Sites access gate also protects local legal pages).
